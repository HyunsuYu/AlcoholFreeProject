MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 397377789}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e33eee4b94fe7f4cb59dc1d504f16d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_layout_Popup: {fileID: 455998094}
  m_tutorialPageDatas:
  - Image: {fileID: 21300000, guid: 26552753bb1f2174bbe9532c82d4ceb4, type: 3}
    Description: "\uCC28\uB840\uB300\uB85C \uB728\uB294 10\uAC00\uC9C0 \uB808\uC2DC\uD53C
      \uC911 \uACF5\uB7B5 \uCE90\uB9AD\uD130\uC5D0\uAC8C \uC120\uBB3C\uD558\uACE0
      \uC2F6\uC740 \uD55C \uAC00\uC9C0 \uB808\uC2DC\uD53C\uB97C \uC120\uD0DD\uD569\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: 3af4944473646724492a8838874af78f, type: 3}
    Description: "\uCC28\uB840\uB300\uB85C \uB728\uB294 10\uAC00\uC9C0 \uB808\uC2DC\uD53C
      \uC911 \uACF5\uB7B5 \uCE90\uB9AD\uD130\uC5D0\uAC8C \uC120\uBB3C\uD558\uACE0
      \uC2F6\uC740 \uD55C \uAC00\uC9C0 \uB808\uC2DC\uD53C\uB97C \uC120\uD0DD\uD569\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: 1e3d83b5088045143b6d28595519116e, type: 3}
    Description: "\uC81C\uC870\uD558\uACE0 \uC2F6\uC740 \uB808\uC2DC\uD53C\uB97C
      \uACE0\uB978 \uD6C4 \uB808\uC2DC\uD53C\uB97C \uD074\uB9AD\uD569\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: aa7193ed68a75184194e758942360dad, type: 3}
    Description: "\uC81C\uC870\uD560 \uCE75\uD14C\uC77C\uC774 \uB9DE\uB2E4\uBA74
      \"\uC608\"\uB97C \uB20C\uB7EC \uCE75\uD14C\uC77C \uC81C\uC870\uB97C \uC2DC\uC791
      \uD569\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: 123d3a795a81ba340bcee5c9105a2520, type: 3}
    Description: "\uBBF8\uB2C8\uAC8C\uC784 \uCE75\uD14C\uC77C\uC744 \uC81C\uC870\uD558\uB294
      \uCC3D \uC785\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: 4f425c96183bab64581a2af10c3a7d87, type: 3}
    Description: 
  - Image: {fileID: 21300000, guid: 580010c9570c42c4ea467b8e24fa2f64, type: 3}
    Description: 
  - Image: {fileID: 21300000, guid: e4f06fa2349f6b34c81200874c7fd3bb, type: 3}
    Description: 
  - Image: {fileID: 21300000, guid: 588b9f8bbb54cf14ea4501ae4a0e98c7, type: 3}
    Description: 
  - Image: {fileID: 21300000, guid: b31f1383131df0b4db64397d0aaec4f8, type: 3}
    Description: "\uC120\uD0DD\uD55C \uB808\uC2DC\uD53C\uC758 \uC81C\uC870 \uC21C\uC11C\uB97C
      \uD655\uC778\uD569\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: f7c0855ff8fd17e468404de3c7c01d79, type: 3}
    Description: "\uC81C\uC870 \uCC3D\uC5D0\uC11C \uB808\uC2DC\uD53C\uB97C \uCC38\uACE0\uD558\uC5EC
      \uC0AC\uBB34\uB77C\uC774 \uB85D\uC744 \uB9CC\uB4ED\uB2C8\uB2E4. \uC6B0\uC120
      \uB3C4\uAD6C\uB97C \uD074\uB9AD\uD558\uC5EC \uC778\uBCA4\uCD08\uB9AC \uCC3D\uC744
      \uC5FD\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: 368611f8cf8860345a304a38eb5660e3, type: 3}
    Description: "\uB3C4\uAD6C\uB97C \uD074\uB9AD\uD558\uC5EC \uC8FC\uC870\uB97C
      \uC704\uD574 \uC250\uC774\uD0B9 \uCEF5\uC744 \uAEBC\uB0C5\uB2C8\uB2E4. \uB9C8\uC6B0\uC2A4\uB97C
      \uAC00\uC838\uB2E4 \uB300\uBA74 \uD574\uB2F9 \uC7AC\uB8CC\uC758 \uC124\uBA85\uC774
      \uB098\uD0C0\uB0A9\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: a85df7a8a66233a4dbdac647a6a46a98, type: 3}
    Description: "\uC250\uC774\uD0B9\uCEF5\uC744 \uD074\uB9AD\uD558\uC5EC \uC8FC\uC870
      \uC900\uBE44\uB97C \uC2DC\uC791\uD569\uB2C8\uB2E4. (\uD770 \uD14C\uB450\uB9AC\uAC00
      \uC788\uB294 \uCEF5\uC774 \uC81C\uC870 \uC911\uC778 \uBB3C\uCCB4\uC785\uB2C8\uB2E4)"
  - Image: {fileID: 21300000, guid: 3e5aaa35919dd2348ab8b0e2048756aa, type: 3}
    Description: "\uC8FC\uB958 \uB610\uB294 \uBE44\uC8FC\uB958\uB294 \uBBF8\uB2C8\uAC8C\uC784
      \uD654\uBA74 \uC624\uB978\uCABD \uB124 \uAC1C\uC758 \uCE78\uC5D0\uC11C \uC120\uD0DD
      \uAC00\uB2A5\uD569\uB2C8\uB2E4. \uD574\uB2F9 \uCE78\uC744 \uD074\uB9AD \uC2DC
      \uC900\uBE44\uB41C \uC8FC\uB958\uC640 \uBE44\uC8FC\uB958\uAC00 \uB098\uD0C0\uB0A9\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: 751b868505f20b24b983fc33422b46f6, type: 3}
    Description: "\uC81C\uC791\uC911\uC778 \uB808\uC2DC\uD53C\uC5D0 \uD544\uC694\uD55C
      \uC7AC\uB8CC\uB97C \uD074\uB9AD\uD558\uC5EC \uAEBC\uB0C5\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: 81de7f766030fea4b88ad55626c21c96, type: 3}
    Description: "\uAEBC\uB0B4\uC9C4 \uC8FC\uB958 \uB610\uB294 \uBE44\uC8FC\uB958\uB294
      \uB4DC\uB798\uADF8\uB97C \uD1B5\uD574 \uC794 \uB610\uB294 \uC250\uC774\uD0B9
      \uCEF5\uC5D0 \uB530\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: a3f95611d4332fb498a823d0f04792ad, type: 3}
    Description: "\uC88C\uD074\uB9AD: \uC7AC\uB8CC \uC120\uD0DD\uCC3D\uC73C\uB85C
      \uB3CC\uC544\uAC11\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: a3f95611d4332fb498a823d0f04792ad, type: 3}
    Description: "\uC6B0\uD074\uB9AD: \uC794 \uB610\uB294 \uC250\uC774\uD0B9 \uCEF5\uC5D0
      \uD55C \uCE78\uC529 \uB530\uB985\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: 445b812def7cd134f9cbc55960f53769, type: 3}
    Description: "\uC6B0\uD074\uB9AD\uD558\uC5EC \uC250\uC774\uD0B9 \uCEF5\uC5D0
      \uBE44\uC728\uC744 \uB9DE\uCDB0 \uC7AC\uB8CC\uB97C \uB123\uC2B5\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: a43e18115f5da5d47af87ffc93fc263e, type: 3}
    Description: "\uB808\uC2DC\uD53C\uB97C \uB530\uB77C \uCE75\uD14C\uC77C\uC744
      \uC81C\uC870\uD569\uB2C8\uB2E4. \uBD80\uC7AC\uB8CC \uCE78\uC744 \uD074\uB9AD
      \uD558\uC5EC \uBD80\uC7AC\uB8CC, \uAC00\uB2C8\uC26C\uB97C \uCD94\uAC00 \uD560
      \uC218 \uC788\uC73C\uBA70 \uC561\uC158\uC744 \uCDE8\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: 4c4cdb41527e38b43af39b3f8104a3a7, type: 3}
    Description: "\uBD80\uC7AC\uB8CC \uC561\uC158\uC744 \uC774\uC6A9\uD558\uC5EC
      \uC250\uC774\uD0B9 \uCEF5\uC744 \uD754\uB4ED\uB2C8\uB2E4. \uC250\uC774\uD0B9
      \uD6C4 \uC794 \uBC84\uD2BC\uC744 \uC774\uC6A9\uD558\uC5EC \uCE75\uD14C\uC77C
      \uC794\uC744 \uAEBC\uB0C5\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: b90109a6e35ff5e4a9c9af212222647c, type: 3}
    Description: "\uAEBC\uB0B4\uC9C4 \uC794\uC774 \uB9DE\uB294\uC9C0 \uD655\uC778
      \uD569\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: 3a921b53bd7b9b240a5a300aa96ee577, type: 3}
    Description: "\uC794\uC73C\uB85C \uC250\uC774\uD0B9 \uCEF5\uC758 \uCE75\uD14C\uC77C\uC744
      \uC62E\uAE30\uAE30 \uC704\uD574 \uC250\uC774\uD0B9 \uCEF5\uC744 \uD074\uB9AD
      \uD6C4 \uC6B0\uD074\uB9AD\uD558\uC5EC \uC561\uCCB4\uB97C \uC62E\uAE41\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: b855668d109bf864fb91bc0b65e43899, type: 3}
    Description: "\uB9C8\uC9C0\uB9C9 \uAC00\uB2C8\uC26C\uB97C \uC62C\uB9B0 \uB4A4
      \uC644\uC131 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uACF5\uB7B5 \uCE90\uB9AD\uD130\uC5D0\uAC8C
      \uC804\uD574\uC904 \uC900\uBE44\uB97C \uB9C8\uCE69\uB2C8\uB2E4."
  - Image: {fileID: 21300000, guid: c1f89e1d4f58bfb48ada3697882aff3d, type: 3}
    Description: "\uC644\uC131\uB41C \uCE75\uD14C\uC77C\uC740 \uC81C\uC870 \uC21C\uC11C,
      \uC7AC\uB8CC\uC758 \uBC30\uC728 \uB4F1\uC5D0 \uB530\uB77C 1\uC131\uBD80\uD130
      5\uC131\uAE4C\uC9C0\uB85C \uB098\uB220\uC9D1\uB2C8\uB2E4. "
  - Image: {fileID: 21300000, guid: 9b6b57988357c41499b7c5ee010e0919, type: 3}
    Description: "1\uC131 \uCE75\uD14C\uC77C\uC744 \uC81C\uC870\uD560 \uC2DC \uC2E4\uD328
      \uB3C4\uC7A5\uC744 2\uC131 \uC774\uC0C1\uC740 \uC131\uACF5 \uB3C4\uC7A5\uC744
      \uBC1B\uAC8C \uB429\uB2C8\uB2E4."
