%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1e53ac1c4ade19042a9e8507c565cf38, type: 3}
  m_Name: BarHintTextData
  m_EditorClassIdentifier: 
  SingleRecipeScripts:
  - RecipeType: 0
    MainTextPacks:
    - TextDatas:
      - TextType: 0
        Text: "\uC6B0\uC120 \uC544\uB984\uB2E4\uC6B0\uBA74\uC11C\uB3C4 \uB3C4\uC218\uAC00
          \uB192\uC740 \uC220\uB85C \uBD80\uD0C1\uD574"
      - TextType: 0
        Text: "\uC794\uC740 \uC220\uC758 \uC544\uB984\uB2E4\uC6C0\uC744 \uADF9\uB300\uD654\uD654\uB294
          \uAC78\uB85C"
      - TextType: 0
        Text: "\uB179\uBE5B \uC694\uC815\uC758 \uC220\uC774\uB77C\uACE0 \uBD88\uB9AC\uB294
          \uAC78 \uC544\uB2C8? "
      - TextType: 0
        Text: "\uADF8\uAC78 \uB9C8\uC2DC\uACE0 \uC2F6\uC740\uB370 \uADF8\uB0E5 \uB9C8\uC2E0\uB2E4\uBA74
          \uB0B4\uAC90 \uD798\uB4E4\uAC83 \uAC19\uC544"
      - TextType: 0
        Text: "\uC870\uAE08\uB9CC \uB123\uC5B4\uC918"
      - TextType: 0
        Text: "\uADF8\uB7EC\uB2C8 \uAC70\uAE30\uC5D0 \uC791\uC740 \uD0C4\uC0B0\uAC10\uC774
          \uC788\uB294 \uC220\uC744 \uD568\uAED8 \uC11E\uC5B4\uC8FC\uACA0\uC5B4?"
      - TextType: 0
        Text: "\uB09C \uD0C4\uC0B0\uAC10\uC774 \uB9CE\uC740 \uAC8C \uC88B\uC740 \uAC83
          \uAC19\uAC70\uB4E0"
      - TextType: 0
        Text: "\uADF8\uB7FC \uBD80\uD0C1\uD560\uAC8C \uD6C4\uD6C4"
    - TextDatas:
      - TextType: 0
        Text: "\uC624\uB298\uC740 \uAC19\uC740 \uC608\uC220\uC744 \uD558\uB358 \uBB38\uD559\uAC00\uCC98\uB7FC
          \uB9C8\uC154\uBCF4\uACE0 \uC2F6\uB124."
      - TextType: 0
        Text: "\uC5B4\uB2C8\uC2A4\uD2B8 \uD5E4\uBC0D\uC6E8\uC774\uAC00 \uC0AC\uB791\uD588\uB358
          \uD55C \uC794\uC778\uB370... "
      - TextType: 0
        Text: "\uC544\uC8FC \uAC15\uB82C\uD55C \uD5C8\uBE0C \uD5A5\uC774 \uB098\uB294
          \uB179\uBE5B \uC545\uB9C8\uC758 \uC220\uC5D0"
      - TextType: 0
        Text: "\uCD95\uBC30\uB97C \uB4E4 \uB54C \uC4F0\uB294 \uD669\uAE08\uBE5B \uBC84\uBE14\uC744
          \uAC00\uB4DD \uCC44\uC6CC\uC918. "
      - TextType: 0
        Text: "\uD6C4\uD6C4. \uC544\uB984\uB2E4\uC6B4 \uC794\uC5D0 \uBD80\uD0C1\uD560\uAC8C."
    PositiveTasteTextPacks: []
    NegativeTasteTextPacks: []
  - RecipeType: 1
    MainTextPacks:
    - TextDatas:
      - TextType: 0
        Text: "\uD639\uC2DC \uD654\uB824\uD55C \uC220\uB3C4 \uB9CC\uB4E4\uC5B4 \uC904
          \uC218 \uC788\uB2C8?"
      - TextType: 0
        Text: "\uB728\uAC81\uAC8C \uD0C0\uC624\uB974\uB294 \uC5F4\uAE30\uB97C \uB290\uB07C\uACE0
          \uC2F6\uC740\uB370"
      - TextType: 0
        Text: "\uB2E8 \uD558\uB098\uC758 \uC220\uC744 \uC704\uD55C \uC544\uB984\uB2E4\uC6B4
          \uC794\uC5D0"
      - TextType: 0
        Text: "\uB179\uBE5B\uC758 \uC704\uD5D8\uD55C \uC220\uC744 5\uBD84\uC758 1\uC815\uB3C4
          \uBD93\uACE0"
      - TextType: 0
        Text: "\uAC70\uAE30\uC5D0 \uB2EC\uCF64\uD568\uC744 \uCD94\uAC00\uD558\uACE0
          \uC2F6\uC5B4 \uCC9C\uCC9C\uD788 \uC990\uAE38 \uC218 \uC788\uB3C4\uB85D"
      - TextType: 0
        Text: "\uBD80\uD0C1\uD574\uB3C4 \uB420\uAE4C?"
      - TextType: 0
        Text: "\uADF8\uB9AC\uACE0 \uB179\uBE5B\uC758 \uC704\uD5D8\uD55C \uC220\uC740
          \uB0B4\uAC00 \uADF8\uB0E5 \uB9C8\uC2DC\uAE30\uC5D4 \uD798\uB4DC\uB2C8 30%\uC73C\uB85C
          \uD76C\uC11D\uD558\uBA74 \uC88B\uACA0\uC5B4"
    - TextDatas:
      - TextType: 0
        Text: "\uC624\uB298\uC740 \uC758\uC2DD\uC774 \uD544\uC694\uD55C \uC220\uC744
          \uB9C8\uC154\uBCFC\uAE4C."
      - TextType: 0
        Text: "\uB179\uC0C9 \uC694\uC815\uC744 \uD2B9\uBCC4\uD55C \uC794\uC5D0 \uBD93\uACE0...
          \uADF8 \uC704\uC5D0 \uAD6C\uBA4D\uC774 \uB6AB\uB9B0 \uC804\uC6A9 \uC2A4\uD47C\uC744
          \uC62C\uB824\uC8FC\uBA74 \uC88B\uACA0\uC5B4."
      - TextType: 0
        Text: "\uADF8\uB9AC\uACE0 \uD558\uC597\uACE0 \uB124\uBAA8\uB09C \uBCF4\uC11D\uC744
          \uADF8 \uC704\uC5D0 \uC62C\uB9B0 \uB4A4, "
      - TextType: 0
        Text: "\uCC28\uAC00\uC6B4 \uBB3C\uC744 \uCC9C\uCC9C\uD788 \uB5A8\uC5B4\uB728\uB824
          \uBCF4\uC11D\uC744 \uB179\uC5EC \uB0B4\uB9AC\uACE0 \uC2F6\uB124."
      - TextType: 0
        Text: "\uC220\uC774 \uBFCC\uC607\uAC8C \uBCC0\uD558\uB294 \uBAA8\uC2B5\uC774
          \uC544\uC8FC \uC544\uB984\uB2F5\uAC70\uB4E0."
      - TextType: 0
        Text: "\uADF8\uB7FC \uBD80\uD0C1\uD560\uAC8C"
    - TextDatas:
      - TextType: 0
        Text: "\uC624\uB298\uC740 \uC608\uC220 \uAC19\uC740 \uC220\uC744 \uC6D0\uD574. "
      - TextType: 0
        Text: "\uB179\uC0C9\uC758 \uBB3C\uAC10\uC744 \uD314\uB808\uD2B8\uC5D0 \uB2F4\uACE0 "
      - TextType: 0
        Text: "\uADF8 \uC704\uC5D0 \uC740\uBE5B \uB2E4\uB9AC\uB97C \uADF8\uB824\uB0B4. "
      - TextType: 0
        Text: "\uADF8\uB9AC\uACE0 \uD558\uC580 \uBB3C\uAC10\uC744 \uC11C\uC11C\uD788
          \uB5A8\uC5B4\uB728\uB9AC\uBA74"
      - TextType: 0
        Text: "\uC220\uC774 \uC548\uAC1C\uCC98\uB7FC \uD750\uB824\uC9C0\uB294 \uADF8
          \uC21C\uAC04\uC744 \uC990\uAE30\uACE0 \uC2F6\uC5B4."
      - TextType: 0
        Text: "\uBD80\uD0C1\uD560\uAC8C"
    PositiveTasteTextPacks: []
    NegativeTasteTextPacks: []
  - RecipeType: 2
    MainTextPacks:
    - TextDatas:
      - TextType: 0
        Text: "\uC74C~ \uC6B0\uC120 \uCEE4\uD53C \uD5A5\uC774 \uD37C\uC9C0\uB294
          \uC220\uC774 \uC88B\uC744 \uAC83 \uAC19\uC544\uC694."
      - TextType: 0
        Text: "\uADF8\uB9AC\uACE0 \uC5B4\uB290 \uC815\uB3C4 \uB2EC\uCF64\uD55C \uC220!
          \uADF8\uCE58\uB9CC \uB108\uBB34  \uB2E8 \uAC74\uC2EB\uC5B4\uC694!!"
      - TextType: 0
        Text: "\uC57D\uAC04 \uB2EC\uB2EC\uD568\uC744 \uC7A1\uC544\uC8FC\uB294 \uC220\uC774
          \uC88B\uC744 \uAC83 \uAC19\uC544\uC694"
      - TextType: 0
        Text: "\uADF8\uB9AC\uACE0~ \uB9C8\uC2DC\uBA74 \uC54C\uB538\uB538 \uD574\uC9C0\uBA74
          \uC88B\uACA0\uB2E4?"
      - TextType: 0
        Text: "\uC794\uC740 \uC601\uD654\uC5D0 \uB098\uC62C\uBC95\uD55C \uBA4B\uC9C4
          \uC794\uC774 \uC88B\uC744\uAC83 \uAC19\uC544\uC694!"
      - TextType: 0
        Text: "\uB7EC\uC2DC\uC544 \uBCF4\uC2A4\uB4E4\uC774 \uB9C8\uC2DC\uB294 \uB290\uB08C!
          \uBB54\uC9C0 \uAC10\uC774 \uC624\uB824\uB098\uC694?"
      - TextType: 0
        Text: "\uADF8\uB807\uAC8C \uD574\uC11C \uC798 \uC11E\uC5B4\uC8FC\uBA74 \uC88B\uC744
          \uAC83 \uAC19\uC544\uC694! \uBD80\uD0C1\uD560\uAC8C\uC694"
    - TextDatas:
      - TextType: 0
        Text: "\uC624\uB298\uC740 \uBB35\uC9C1\uD558\uACE0 \uB2E8\uC21C\uD55C \uAC8C
          \uC88B\uC744 \uAC83 \uAC19\uC544\uC694."
      - TextType: 0
        Text: "\uBD84\uC704\uAE30 \uC788\uAC8C \uB0AE\uACE0 \uB450\uD23C\uD55C \uC794\uC5D0
          \uB124\uBAA8\uB09C \uC5BC\uC74C\uC744 \uCC44\uC6B0\uACE0... "
      - TextType: 0
        Text: "\uCEE4\uD53C\uB9DB\uC774 \uB098\uB294 \uC220\uC774\uBA74 \uC88B\uC744
          \uAC83 \uAC19\uC544\uC694!"
      - TextType: 0
        Text: "\uD558\uC9C0\uB9CC \uADF8\uAC83\uB9CC\uC73C\uB860 \uB108\uBB34 \uB2EC\uACA0\uC8E0..?
          \uC74C~ "
      - TextType: 0
        Text: "\uC544! \uAC70\uAE30\uC5D0 \uADF8 \uB2E8\uB9DB\uC744 \uC2F9 \uC7A1\uC544\uC904,
          \uAE54\uB054\uD558\uAC8C \uC7A1\uC544\uC904 \uB3C4\uC218\uAC00 \uC788\uB294
          \uC220\uC744 \uB123\uC5B4\uC8FC\uBA74 \uC88B\uC744 \uAC83 \uAC19\uC544\uC694!"
      - TextType: 0
        Text: "4\uB3003 \uBE44\uC728\uB85C\uC694!"
      - TextType: 0
        Text: "\uC774\uB807\uAC8C \uB531 \uB450 \uAC00\uC9C0\uB9CC\uC73C\uB85C \uBD80\uD0C1\uD560\uAC8C\uC694!"
    PositiveTasteTextPacks: []
    NegativeTasteTextPacks: []
  - RecipeType: 3
    MainTextPacks:
    - TextDatas:
      - TextType: 0
        Text: "\uC624\uB298\uC740 \uCE74\uD398\uC5D0\uC11C \uD314 \uAC83 \uAC19\uC740
          \uC220\uC774 \uB9C8\uC2DC\uACE0 \uC2F6\uC5B4\uC694"
      - TextType: 0
        Text: "\uCEE4\uD53C \uD5A5\uC774 \uB098\uBA74\uC11C \uB2EC\uCF64\uD558\uC9C0\uB9CC,
          \uC309\uC2F8\uB798\uD55C \uB9DB"
      - TextType: 0
        Text: "\uC54C\uB538\uB538\uD558\uBA74\uC11C\uB3C4 \uC9C4\uD55C \uC5D0\uC2A4\uD504\uB808\uC18C
          \uC6D0 \uC0F7\uC774 \uB4E4\uC5B4\uAC00 \uCEE4\uD53C \uD5A5\uC774 \uAC15\uD558\uAC8C
          \uB098\uBA74 \uC88B\uACA0\uC5B4\uC694"
      - TextType: 0
        Text: "\uC6B0\uC720\uAC00 \uB109\uB109\uD558\uAC8C \uB4E4\uC5B4\uAC00 \uBD80\uB4DC\uB7EC\uC6B4
          \uB77C\uB5BC \uB290\uB08C\uC774 \uB4E4\uBA74 \uC88B\uACA0\uB2E4?"
      - TextType: 0
        Text: "\uCE75\uD14C\uC77C\uC774 \uB9C8\uCE58 \uC74C\uB8CC\uAC19\uC558\uC73C\uBA74
          \uD574\uC694!"
      - TextType: 0
        Text: "\uADF8\uCE58\uB9CC \uBA4B\uC744 \uCC59\uAE30\uB294 \uC794\uB3C4 \uC911\uC694\uD558\uB2E4!!"
      - TextType: 0
        Text: "\uB0AE\uACE0 \uB450\uD23C\uD55C \uC794\uC5D0 \uAC01\uC9C4 \uC5BC\uC74C\uC73C\uB85C
          \uC544\uC8FC \uC2DC\uC6D0\uD558\uAC8C \uBD80\uD0C1\uD560\uAC8C\uC694!"
    - TextDatas:
      - TextType: 0
        Text: "\uC624\uB298\uC740 \uB0AE\uACE0 \uB450\uD23C\uD55C \uC794\uC5D0 \uB77C\uB5BC
          \uAC19\uC740 \uCE75\uD14C\uC77C\uC744 \uB9C8\uC2DC\uACE0 \uC2F6\uC5B4\uC694."
      - TextType: 0
        Text: "\uB2EC\uCF64\uD55C \uCEE4\uD53C \uB9DB\uC774 \uB098\uBA74 \uC88B\uC744
          \uAC83 \uAC19\uACE0~"
      - TextType: 0
        Text: "\uC5EC\uAE30\uC5D0 \uAE54\uB054\uD558\uACE0 \uB3C4\uC218 \uB192\uC740
          \uC220\uC744 \uC870\uAE08\uC529\uB9CC \uB123\uACE0... "
      - TextType: 0
        Text: "\uC544! \uAC70\uAE30\uC5D0 \uBC29\uAE08 \uB0B4\uB9B0 \uC9C4\uD55C
          \uC0F7\uC744 \uD558\uB098 \uCD94\uAC00\uD574 \uC8FC\uC138\uC694!"
      - TextType: 0
        Text: "\uAC19\uC740 \uBE44\uC728\uB85C \uB123\uC5B4\uC8FC\uC138\uC694!"
      - TextType: 0
        Text: "\uC813\uB294 \uAC83\uB3C4 \uC78A\uC9C0 \uB9C8\uC2DC\uAD6C\uC694!!"
      - TextType: 0
        Text: "\uC309\uC300\uD558\uAC8C~ \uB9C8\uC2DC\uACE0 \uC2F6\uAC70\uB4E0\uC694.
          \uD5E4\uD5E4"
      - TextType: 0
        Text: "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC794\uC758 \uC808\uBC18 \uC774\uC0C1\uC744
          \uC6B0\uC720\uB85C \uB109\uB109\uD558\uAC8C \uCC44\uC6CC\uC8FC\uC138\uC694!"
      - TextType: 0
        Text: "\uBD80\uD0C1\uD560\uAC8C\uC694!"
    PositiveTasteTextPacks: []
    NegativeTasteTextPacks: []
  - RecipeType: 4
    MainTextPacks:
    - TextDatas:
      - TextType: 0
        Text: "\uB09C \uC640\uC778\uC744 \uD65C\uC6A9\uD55C \uCE75\uD14C\uC77C\uC744
          \uB0B4\uC92C\uC73C\uBA74 \uD574."
      - TextType: 0
        Text: "\uC640\uC778\uC794\uC5D0 \uB3D9\uADF8\uB797\uACE0 \uB2EC\uCC98\uB7FC
          \uC544\uB984\uB2E4\uC6B4 \uC5BC\uC74C\uC744 \uB123\uC5B4\uC918."
      - TextType: 0
        Text: "\uD6C4\uD6C4.. \uBB35\uC9C1\uD55C \uBC14\uB514\uAC10\uC744 \uC870\uAE08
          \uAC00\uBCCD\uAC8C \uD574\uC904 \uBB34\uC5B8\uAC00\uB97C \uB123\uC5B4\uC8FC\uBA74
          \uC88B\uACA0\uB124."
      - TextType: 0
        Text: "\uADF8\uCE58\uB9CC \uC640\uC778\uC758 \uD5A5\uC744 \uD574\uCE58\uACE0
          \uC2F6\uC9C4 \uC54A\uC544. \uCF5C\uB77C\uB098 \uC0AC\uC774\uB2E4 \uAC19\uC740
          \uB2E8\uB9DB \uB098\uB294 \uC74C\uB8CC \uB9D0\uACE0, \uC544\uC8FC \uAE54\uB054\uD55C
          \uD0C4\uC0B0\uC744 \uC640\uC778 \uBCF4\uB2E4\uB294 \uC870\uAE08 \uC801\uAC8C
          \uB123\uC5B4\uC918."
      - TextType: 0
        Text: "\uADF8\uB807\uAC8C \uADF8 \uB458\uC744 \uC5B4\uC6B8\uB9AC\uAC8C \uC798
          \uC11E\uC5B4\uC11C \uB0B4\uC5B4\uC918"
      - TextType: 0
        Text: "\uBD80\uD0C1\uD560\uAC8C. \uBC14\uD150\uB354\uC528"
    - TextDatas:
      - TextType: 0
        Text: "\uBB35\uC9C1\uD55C \uC9C4\uD64D\uBE5B \uC640\uC778\uC744 \uB9C8\uC2DC\uACE0
          \uC2F6\uC740\uB370, "
      - TextType: 0
        Text: "\uC624\uB298\uC740 \uB0A0\uC774 \uB354\uC6CC \uC870\uAE08 \uAC00\uBCCD\uAC8C
          \uC990\uAE30\uACE0 \uC2F6\uB124."
      - TextType: 0
        Text: "\uADF8 \uD5A5\uC744 \uD574\uCE58\uC9C0 \uC54A\uB294 \uC120\uC5D0\uC11C... "
      - TextType: 0
        Text: "\uB2EC\uC9C0 \uC54A\uAC8C \uD0C4\uC0B0\uC744 \uC11E\uC5B4 \uCCAD\uB7C9\uAC10\uB9CC
          \uB354\uD574\uC904 \uC218 \uC788\uC73C\uB824\uB098"
      - TextType: 0
        Text: "\uC794\uC740 \uC640\uC778\uC744 \uB2F4\uB294 \uC794\uC744 \uADF8\uB300\uB85C
          \uC368\uC918."
    PositiveTasteTextPacks: []
    NegativeTasteTextPacks: []
  - RecipeType: 5
    MainTextPacks:
    - TextDatas:
      - TextType: 0
        Text: "\uC624\uB298 \uCE75\uD14C\uC77C\uC740 \uB2EC\uCF64\uD55C \uAC8C \uC88B\uACA0\uC5B4"
      - TextType: 0
        Text: "\uC5B4\uB978\uC2A4\uB7EC\uC6B4 \uC640\uC778\uC758 \uB9DB\uC744 \uAC10\uC2F8\uB294
          \uB2EC\uCF64\uD558\uACE0 \uD1A1 \uC3D8\uB294 \uB9DB"
      - TextType: 0
        Text: "\uD6C4\uD6C4 \uB9C8\uCE58 \uB2F9\uC2E0\uCC98\uB7FC \uB9D0\uC774\uC57C
          \uD3EC\uB3C4\uC8FC\uC2A4\uC528"
      - TextType: 0
        Text: "\uADF8\uB9AC\uACE0 \uC640\uC778\uC744 \uB2F4\uC544 \uC798 \uC11E\uC5B4\uC918"
      - TextType: 0
        Text: "\uADF8\uB9AC\uACE0 \uADF8 \uBAA8\uC2B5\uC774 \uC798 \uBCF4\uC774\uB3C4\uB85D
          \uAC00\uB298\uACE0 \uAE34 \uC794\uC744 \uC0AC\uC6A9\uD574 \uC92C\uC73C\uBA74
          \uD574"
      - TextType: 0
        Text: "\uAC70\uAE30\uC5D0 \uB178\uB780 \uBE5B\uC758 \uC0C1\uD07C\uD568\uC744
          \uD55C \uC870\uAC01 \uB354\uD558\uBA74 \uC815\uB9D0 \uB9C8\uC74C\uC5D0
          \uB4E4 \uAC83 \uAC19\uC544 \uADF8\uB7FC \uBD80\uD0C1\uD560\uAC8C?"
    - TextDatas:
      - TextType: 0
        Text: "\uC624\uB298\uC740 \uC7A5\uB09C\uC2A4\uB7EC\uC6B4 \uC220\uC774 \uC88B\uACA0\uC5B4."
      - TextType: 0
        Text: "\uAE38\uCB49\uD55C \uC794\uC5D0 \uAC01 \uC5BC\uC74C\uC744 \uAC00\uB4DD
          \uCC44\uC6B0\uACE0"
      - TextType: 0
        Text: "\uC5B4\uB978\uC758 \uC74C\uB8CC\uC640 \uB2EC\uCF64\uD55C \uC544\uC774\uB4E4\uC758
          \uC74C\uB8CC\uB97C \uBC18\uBC18\uC529 \uAC00\uB4DD \uB123\uC5B4\uC11C \uC11E\uC5B4\uC918. "
      - TextType: 0
        Text: "\uC5B4\uC6B8\uB9B4 \uAC83 \uAC19\uC9C0 \uC54A\uC9C0\uB9CC \uC544\uC8FC
          \uB9E4\uB825\uC801\uC774\uAC70\uB4E0. "
      - TextType: 0
        Text: "\uB9C8\uC9C0\uB9C9 \uD55C \uC870\uAC01\uC758 \uD3EC\uC778\uD2B8\uB85C
          \uC0C1\uD07C\uD568\uB3C4 \uB354\uD574\uC918."
      - TextType: 0
        Text: "\uBD80\uD0C1\uD560\uAC8C"
    PositiveTasteTextPacks: []
    NegativeTasteTextPacks: []
  - RecipeType: 6
    MainTextPacks:
    - TextDatas:
      - TextType: 0
        Text: "\uB09C \uC544\uB984\uB2E4\uC6B4 \uAC8C \uC88B\uC544! \uC220\uB3C4
          \uB9C8\uCC2C\uAC00\uC9C0\uC57C"
      - TextType: 0
        Text: "\uC544\uB984\uB2E4\uC6B4 \uBAA8\uC2B5\uC774 \uC798 \uBCF4\uC774\uB294
          \uC220\uC794\uC5D0 \uB2F4\uC544 \uC918!"
      - TextType: 0
        Text: "\uADF8 \uC548\uC5D0 \uAE34 \uC5BC\uC74C\uC744 \uB123\uACE0"
      - TextType: 0
        Text: "\uB0B4 \uB208\uB3D9\uC790\uC640 \uAC19\uC740 \uD478\uB978 \uBC14\uB2E4\uC640
          \uAC19\uC740 \uC0C9\uC758 \uC220\uC744 \uB9C8\uC154\uBCF4\uACE0 \uC2F6\uC5B4 "
      - TextType: 0
        Text: "\uC801\uC9C0\uB3C4 \uC54A\uACE0 \uB9CE\uC9C0\uB3C4 \uC54A\uAC8C!"
      - TextType: 0
        Text: "\uADF8\uB7EC\uBA74\uC11C\uB3C4 \uC6B0\uC720\uCC98\uB7FC \uBD80\uB4DC\uB7FD\uACE0
          \uB2EC\uCF64\uD55C \uD0C4\uC0B0\uC774 \uB290\uAEF4\uC84C\uC73C\uBA74 \uD558\uB2E8
          \uB9D0\uC774\uC9C0~"
      - TextType: 0
        Text: "\uB09C \uD0C4\uC0B0\uC744 \uC88B\uC544\uD574\uC11C \uC220\uBCF4\uB2E4
          \uC870\uAE08 \uB9CE\uC774 \uB123\uC5B4\uC918!"
      - TextType: 0
        Text: "\uC544! \uB9C8\uC9C0\uB9C9\uC5D4 \uAF2D \uC7A5\uC2DD\uC744 \uB123\uC5B4\uC57C
          \uD574! \uC0C1\uD07C\uD568\uC744 \uCD94\uAC00\uD574 \uC918 \uC54C\uACA0\uC9C0?
          \uADF8\uB7FC \uBD80\uD0C1\uD560\uAC8C \uBC14\uD150\uB354!"
    - TextDatas:
      - TextType: 0
        Text: "\uC624\uB298\uC740 \uD658\uC0C1 \uAC19\uC740 \uC220\uC744 \uB9C8\uC154\uBCF4\uACE0
          \uC2F6\uC5B4. "
      - TextType: 0
        Text: "\uD478\uB978 \uC5F4\uB300\uC758 \uBC14\uB2E4\uC640 \uBD80\uB4DC\uB7EC\uC6B4
          \uC6B0\uC720 \uC740\uD558\uC218\uAC00 \uB9CC\uB098\uB294 \uCE75\uD14C\uC77C\uC778\uB370"
      - TextType: 0
        Text: "\uC774 \uB458\uC774 \uB9CC\uB098\uBA74 \uD30C\uC2A4\uD154\uD1A4\uC758
          \uAD6C\uB984\uCC98\uB7FC \uBCC0\uD55C\uB300! \uC2E0\uAE30\uD558\uC9C0?"
      - TextType: 0
        Text: "\uC774\uB984\uC740 \uC774 \uB450 \uC7AC\uB8CC\uAC00 \uC7A5\uB09C\uC2A4\uB808
          \uC785\uC744 \uB9DE\uCD94\uB294 \uC18C\uB9AC\uB77C\uB358\uB370..."
      - TextType: 0
        Text: "\uC5B4\uB77C \uC9C0\uAE08 \uBD80\uB044\uB7EC\uC6CC\uD558\uB294 \uAC70\uC57C?"
      - TextType: 0
        Text: "\uC7A5\uB09C\uC774\uC57C \uADF8\uB7FC \uB9DB\uC788\uAC8C \uBD80\uD0C1\uD560\uAC8C!"
    PositiveTasteTextPacks: []
    NegativeTasteTextPacks: []
  - RecipeType: 7
    MainTextPacks:
    - TextDatas:
      - TextType: 0
        Text: "\uC624\uB298\uC740 \uBB54\uAC00 \uC0C9\uB2E4\uB978 \uAC78 \uB9C8\uC154\uBCF4\uACE0
          \uC2F6\uC5B4"
      - TextType: 0
        Text: "\uC608\uC804 \uC601\uD654\uC5D0\uC11C \uBCF8 \uCE75\uD14C\uC77C\uC778\uB370"
      - TextType: 0
        Text: "\uD654\uB824\uD55C \uC794\uC778\uB370 \uBB54\uAC00 \uD68C\uC7A5\uB2D8\uB4E4\uC774
          \uC4F8 \uAC83 \uAC19\uC740 \uB290\uB08C\uC758 \uC794\uC5D0 \uC5BC\uC74C\uC744
          \uB2F4\uC544\uC11C"
      - TextType: 0
        Text: "\uD654\uB824\uD558\uACE0 \uB300\uC870\uB418\uB294 \uC544\uB984\uB2E4\uC6C0\uC774
          \uC788\uB2E4\uBA74 \uC88B\uACA0\uC5B4 "
      - TextType: 0
        Text: "\uADF8 \uB458\uC774 \uAC19\uC740 \uBE44\uC728\uB85C \uB9CE\uC774 \uB123\uC73C\uBA74
          \uC88B\uC744 \uAC83 \uAC19\uC544"
      - TextType: 0
        Text: "\uADF8\uB9AC\uACE0 \uB450 \uC0C9\uC744 \uC11E\uC73C\uBA74 \uCF85!\uD558\uACE0
          \uBD80\uB52A\uD788\uBA70 \uCD08\uB85D\uBE5B\uC774 \uB09C\uB2E4\uACE0 \uD558\uB354\uB77C\uACE0?"
      - TextType: 0
        Text: "\uD558\uD558 \uC7A5\uB09C\uC774\uC57C \uC9C4\uC9DC \uCF85! \uD558\uC9C0\uB294
          \uC54A\uC544"
      - TextType: 0
        Text: "\uC870\uAE08 \uC5B4\uB835\uC9C0\uB9CC \uBD80\uD0C1\uD574\uB3C4 \uB420\uAE4C?"
    - TextDatas:
      - TextType: 0
        Text: "\uC624\uB298\uC740 \uD2B9\uC774\uD558\uAC8C \uBCC0\uC2E0\uD558\uB294
          \uC220\uC744 \uB9DB\uBCF4\uACE0 \uC2F6\uC5B4"
      - TextType: 0
        Text: "\uC77C\uB2E8 \uBA4B\uC774 \uC788\uC5B4\uC57C \uD558\uB2C8 \uD68C\uC7A5\uB2D8\uB4E4\uC774
          \uC4F8 \uBC95\uD55C \uBB35\uC9C1\uD55C \uC794\uC5D0 \uC5BC\uC74C\uC744
          \uB123\uACE0,"
      - TextType: 0
        Text: "\uC5F4\uB300 \uACFC\uC77C \uB9DB\uC774 \uB098\uB294 \uD478\uB978\uC0C9
          \uC220\uACFC \uD3EC\uB3C4 \uD5A5\uC774 \uB098\uB294 \uD669\uAE08\uBE5B
          \uC220\uC744 \uB611\uAC19\uC774 1:1\uB85C \uBD80\uC5B4\uBCF4\uB294 \uAC70\uC57C!!"
      - TextType: 0
        Text: "\uADF8\uB7FC \uB450 \uC0C9\uC774 \uC11E\uC774\uBA74\uC11C... \uAC15\uB82C\uD55C
          \uCD08\uB85D\uC0C9\uC73C\uB85C \uBCC0\uD574\uBC84\uB9AC\uC9C0!"
      - TextType: 0
        Text: "\uC5B4\uB54C \uC2E0\uAE30\uD558\uC9C0 \uC54A\uC544? \uC774\uB984\uB3C4
          \uADF8 \uCD08\uB85D\uC0C9 \uAD34\uBB3C\uC5D0\uC11C \uB530\uC654\uB2E4\uACE0
          \uD574."
      - TextType: 0
        Text: "\uBB3C\uB860 \uB09C \uB0B4\uAC00 \uC9C1\uC811 \uC11E\uC744\uD14C\uB2C8
          \uB10C \uC11E\uC5B4\uC8FC\uC9C0 \uC54A\uC544\uB3C4 \uB3FC!"
      - TextType: 0
        Text: "\uADF8\uB7FC \uBD80\uD0C1\uD560\uAC8C"
    PositiveTasteTextPacks: []
    NegativeTasteTextPacks: []
  - RecipeType: 8
    MainTextPacks:
    - TextDatas:
      - TextType: 0
        Text: "\uC548\uB155\uD558\uC138\uC694~ \uC624\uB298\uC740 \uC870\uAE08 \uAE54\uB054\uD55C
          \uAC78 \uB9C8\uC154\uBCF4\uACE0 \uC2F6\uB124\uC694"
      - TextType: 0
        Text: "\uC815\uC11D \uCE75\uD14C\uC77C \uC794\uC5D0 \uB2F4\uAE30\uBA74 \uC88B\uACA0\uB2E4\uACE0
          \uC0DD\uAC01\uD574\uC694"
      - TextType: 0
        Text: "\uB9DB\uC740 \uAE54\uB054\uD558\uACE0 \uBD80\uB4DC\uB7EC\uC6B4 \uB290\uB08C\uC774
          \uB4E4\uBA74 \uC88B\uACA0\uB294\uB370 \uD639\uC2DC  \uC300 \uAC19\uC740
          \uB9DB\uB3C4 \uB0BC \uC218 \uC788\uC744\uAE4C\uC694?"
      - TextType: 0
        Text: "\uB3C4\uC218\uB294 \uB192\uC544\uC838\uB3C4 \uAD1C\uCC2E\uC544\uC694!
          \uB300\uC2E0 \uBAA9 \uB118\uAE40\uC774 \uBD80\uB4DC\uB7EC\uC6E0\uC73C\uBA74
          \uC88B\uACA0\uC5B4\uC694!"
      - TextType: 0
        Text: "\uADF8\uB9AC\uACE0 \uC544\uC8FC \uC798 \uC11E\uC5B4\uC11C \uC774 \uB450
          \uB9DB\uC774 \uD558\uB098\uAC00 \uB418\uC5B4 \uC5F0\uACB0\uB418\uAE38 \uC6D0\uD574\uC694"
      - TextType: 0
        Text: "\uC5EC\uAE30\uC5D0 \uAC10 \uCE60\uB9DB\uACFC \uC9ED\uC9E4\uD55C \uB9DB\uC774
          \uB098\uB294 \uD1A0\uD551\uC774 \uC788\uB2E4\uBA74 \uC88B\uC744 \uAC83
          \uAC19\uC544\uC694"
      - TextType: 0
        Text: "\uC5B4\uB978\uC2A4\uB7EC\uC6B4 \uB290\uB08C\uC758 \uCE75\uD14C\uC77C\uC774\uBA74
          \uC88B\uACA0\uB2E4? \uBD80\uD0C1\uD574\uB3C4 \uB420\uAE4C\uC694?"
    - TextDatas:
      - TextType: 0
        Text: "\uC624\uB298\uC740 \uC815\uC11D\uC801\uC778 \uC794\uC5D0 \uAE54\uB054\uD55C
          \uC220\uC744 \uBD80\uD0C1\uD560\uAC8C\uC694."
      - TextType: 0
        Text: "\uB3D9\uC11C\uC591\uC758 \uC870\uD654\u2026 \uB784\uAE4C\uC694?"
      - TextType: 0
        Text: "\uC6B0\uC120 \uC11E\uC744 \uC218 \uC788\uB294 \uD1B5\uC5D0 \uC300\uB85C
          \uB9CC\uB4E0 \uB9D1\uC740 \uC220\uC744 \uB109\uB109\uD558\uAC8C \uBD93\uACE0, "
      - TextType: 0
        Text: "\uC11C\uC591\uC758 \uC220\uC740 \uADF8\uAC83\uBCF4\uB2E4 \uC870\uAE08
          \uC801\uAC8C \uB123\uC5B4\uC918 \uC8FC\uC138\uC694"
      - TextType: 0
        Text: "\uD798\uCC28\uAC8C \uD754\uB4E4\uC5B4\uC11C \uCC28\uAC11\uAC8C \uB9CC\uB4E0
          \uB2E4\uC74C \uC794\uC5D0 \uBC18 \uC774\uC0C1 \uB530\uB77C\uC8FC\uC2DC\uBA74
          \uC88B\uC744 \uAC83 \uAC19\uC544\uC694"
      - TextType: 0
        Text: "\uADF8\uB9AC\uACE0 \uC758\uC678\uC9C0\uB9CC \uC9ED\uC9E4\uD55C \uADF8
          \uAF2C\uCE58\uAC00 \uC62C\uB77C\uAC04\uB2E4\uBA74 \uB354 \uC88B\uC744 \uAC83
          \uAC19\uB124\uC694 \uADF8\uB7FC \uBD80\uD0C1\uD560\uAC8C\uC694!"
    PositiveTasteTextPacks: []
    NegativeTasteTextPacks: []
  - RecipeType: 9
    MainTextPacks:
    - TextDatas:
      - TextType: 0
        Text: "\uC6B0\uC120 \uD654\uB824\uD55C \uC794\uC5D0 \uB3D9\uADF8\uB780 \uC5BC\uC74C\uC774
          \uC88B\uACA0\uC5B4\uC694. "
      - TextType: 0
        Text: "\uAC70\uAE30\uC5D0 \uC300\uC758 \uD5A5\uC774 \uC740\uC740\uD558\uAC8C
          \uD37C\uC9C0\uB294, \uBD80\uB4DC\uB7EC\uC6B4 \uC220\uC744 \uBCA0\uC774\uC2A4\uB85C
          \uBC18\uBCF4\uB2E4\uB294 \uC801\uAC8C \uB123\uC5B4 \uB9C8\uC2DC\uACE0 \uC2F6\uB124\uC694."
      - TextType: 0
        Text: "\uD558\uC9C0\uB9CC \uADF8 \uBD80\uB4DC\uB7EC\uC6C0\uB9CC \uC788\uC73C\uBA74
          \uC2EC\uC2EC\uD558\uACA0\uC8E0?  \uC544\uC8FC \uC2E0 \uB9DB\uC774 \uB098\uB294
          \uB179\uBE5B \uACFC\uC77C\uC744 \uC9DC \uB123\uC5B4\uC11C,  \uD600\uB97C
          \uC0C8\uCF64\uD558\uAC8C \uAC10\uC2F8\uB294 \uB9DB\uC744 \uC870\uAE08 \uB354\uD574\uC8FC\uC138\uC694. "
      - TextType: 0
        Text: "\uC544!\uCE75\uD14C\uC77C \uC0C9\uC774 \uB179\uC0C9\uC774\uB77C\uB294
          \uB73B\uC740 \uC544\uB2C8\uC5D0\uC694!"
      - TextType: 0
        Text: "\uB9C8\uC9C0\uB9C9 \uC7A5\uC2DD\uB3C4 \uADF8 \uACFC\uC77C \uC870\uAC01\uC73C\uB85C
          \uAE54\uB054\uD558\uAC8C \uB9C8\uBB34\uB9AC\uD558\uBA74 \uC88B\uACA0\uB124\uC694!"
      - TextType: 0
        Text: "\uADF8\uB7FC \uBD80\uD0C1\uB4DC\uB9B4\uAC8C\uC694."
    - TextDatas:
      - TextType: 0
        Text: "\uC624\uB298\uC740 \uBB34\uC0AC\uAC00 \uB098\uC624\uB294 \uCC45\uC744
          \uC77D\uC5B4\uC11C \uADF8\uB7F0\uAC00? \uBB34\uC0AC \uAC19\uC740 \uC220\uC774
          \uB9C8\uC2DC\uACE0 \uC2F6\uC5B4\uC694! "
      - TextType: 0
        Text: "\uC6B0\uC120 \uB0AE\uC9C0\uB9CC, \uD654\uB824\uD55C \uC794\uC5D0 \uB3D9\uADF8\uB780
          \uC5BC\uC74C\uC744 \uB123\uACE0"
      - TextType: 0
        Text: "\uBCA0\uC774\uC2A4\uB294 \uC300\uC758 \uD5A5\uC774 \uC740\uC740\uD558\uAC8C
          \uD37C\uC9C0\uB294 \uB9D1\uC740 \uC220\uB85C \uD558\uACE0,"
      - TextType: 0
        Text: "\uAC70\uAE30\uC5D0 \uCD08\uB85D\uBE5B \uAC80\uC220\uC744 \uC368\uC11C
          \uC0C8\uCF64\uD55C \uB9DB\uC744 \uB354\uD574\uC8FC\uC138\uC694!"
      - TextType: 0
        Text: "\uC544\uC8FC \uB2E8\uC21C\uD558\uC9C0\uB9CC \uAE54\uB054\uD574\uC11C
          \uC624\uB298 \uC77D\uC740 \uCC45\uC774\uB791 \uC798 \uC5B4\uC6B8\uB9B4
          \uAC83 \uAC19\uC544\uC694!"
      - TextType: 0
        Text: "\uC544 \uADF8\uB9AC\uACE0 \uAC70\uAE30\uC5D0 \uCD08\uB85D\uBE5B\uC73C\uB85C
          \uB9C8\uC9C0\uB9C9\uC744 \uC7A5\uC2DD\uD560 \uD55C \uC870\uAC01\uC744 \uBD80\uD0C1\uD560\uAC8C\uC694!"
    PositiveTasteTextPacks: []
    NegativeTasteTextPacks: []
